---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

const stats = [
  { value: '1931', label: 'the company started', labelKm: 'ក្រុមហ៊ុនចាប់ផ្តើម' },
  { value: '1963', label: 'the first 911', labelKm: 'រថយន្ត 911 ដំបូងគេ' },
  { value: '#1', label: 'most wins at the Le Mans 24 Hours race', labelKm: 'ឈ្នះច្រើនជាងគេនៅការប្រណាំង Le Mans ២៤ ម៉ោង' },
];

const models = [
  {
    icon: '🏎️',
    name: '911',
    type: 'Sports car',
    typeKm: 'រថយន្តស្ព័រ',
    text: 'The famous one. Its engine is at the back.',
    textKm: 'រថយន្តដ៏ល្បី។ ម៉ាស៊ីនរបស់វានៅខាងក្រោយ។',
  },
  {
    icon: '🏁',
    name: '718 Boxster & Cayman',
    type: 'Small sports car',
    typeKm: 'រថយន្តស្ព័រតូច',
    text: 'Two seats. The engine is in the middle.',
    textKm: 'មានកៅអីពីរ។ ម៉ាស៊ីននៅកណ្តាល។',
  },
  {
    icon: '⚡',
    name: 'Taycan',
    type: 'Electric car',
    typeKm: 'រថយន្តអគ្គិសនី',
    text: 'Porsche’s first electric car, from 2019.',
    textKm: 'រថយន្តអគ្គិសនីដំបូងរបស់ Porsche ចាប់ពីឆ្នាំ ២០១៩។',
  },
  {
    icon: '🚘',
    name: 'Panamera',
    type: 'Four-door car',
    typeKm: 'រថយន្តទ្វារបួន',
    text: 'Fast, with room for the whole family.',
    textKm: 'លឿន ហើយមានកន្លែងសម្រាប់គ្រួសារទាំងមូល។',
  },
  {
    icon: '🚙',
    name: 'Cayenne',
    type: 'Big SUV',
    typeKm: 'រថយន្ត SUV ធំ',
    text: 'Porsche’s first SUV, from 2002.',
    textKm: 'រថយន្ត SUV ដំបូងរបស់ Porsche ចាប់ពីឆ្នាំ ២០០២។',
  },
  {
    icon: '🚙',
    name: 'Macan',
    type: 'Smaller SUV',
    typeKm: 'រថយន្ត SUV តូចជាង',
    text: 'A smaller SUV, from 2014.',
    textKm: 'រថយន្ត SUV តូចជាង ចាប់ពីឆ្នាំ ២០១៤។',
  },
];

const history = [
  {
    year: '1931',
    text: 'Ferdinand Porsche starts his company in Stuttgart, Germany.',
    textKm: 'លោក Ferdinand Porsche ចាប់ផ្តើមក្រុមហ៊ុនរបស់គាត់ នៅទីក្រុង Stuttgart ប្រទេសអាល្លឺម៉ង់។',
  },
  {
    year: '1948',
    text: 'The 356: the first car with the Porsche name.',
    textKm: 'រថយន្ត 356៖ ជារថយន្តដំបូងដែលមានឈ្មោះ Porsche។',
  },
  {
    year: '1963',
    text: 'The 911 is shown for the first time.',
    textKm: 'រថយន្ត 911 ត្រូវបានបង្ហាញជាលើកដំបូង។',
  },
  {
    year: '2002',
    text: 'The Cayenne: Porsche’s first SUV.',
    textKm: 'Cayenne៖ ជារថយន្ត SUV ដំបូងរបស់ Porsche។',
  },
  {
    year: '2019',
    text: 'The Taycan: Porsche’s first electric car.',
    textKm: 'Taycan៖ ជារថយន្តអគ្គិសនីដំបូងរបស់ Porsche។',
  },
];

const faqs = [
  {
    q: 'How do you say “Porsche”?',
    qKm: 'តើអាន “Porsche” យ៉ាងដូចម្តេច?',
    a: 'POR-shuh, with two parts. It is a family name.',
    aKm: 'អានថា POR-shuh មានពីរព្យាង្គ។ វាជានាមត្រកូលរបស់គ្រួសារមួយ។',
  },
  {
    q: 'Where are Porsche cars made?',
    qKm: 'តើរថយន្ត Porsche ផលិតនៅឯណា?',
    a: 'Most are made in Germany. The main factory is in Stuttgart.',
    aKm: 'ភាគច្រើនផលិតនៅប្រទេសអាល្លឺម៉ង់។ រោងចក្រធំនៅទីក្រុង Stuttgart។',
  },
  {
    q: 'Is this the official Porsche website?',
    qKm: 'តើនេះជាគេហទំព័រផ្លូវការរបស់ Porsche ទេ?',
    a: 'No. This is a fan website. For the official website, visit porsche.com.',
    aKm: 'ទេ។ នេះជាគេហទំព័ររបស់អ្នកគាំទ្រ។ សម្រាប់គេហទំព័រផ្លូវការ សូមចូលទៅ porsche.com។',
  },
];
---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-brand/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-brand"></span>
            A fan website from Cambodia
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            Fast, beautiful, and made in <span class="text-brand">Germany</span>.
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">លឿន ស្អាត និងផលិតនៅប្រទេសអាល្លឺម៉ង់។</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            Learn about Porsche’s famous cars, its history, and fun facts. Made by a fan, for fans.
            <span class="km" lang="km">ស្វែងយល់អំពីរថយន្តល្បីៗរបស់ Porsche ប្រវត្តិរបស់វា និងចំណេះដឹងគួរឱ្យចាប់អារម្មណ៍។ បង្កើតដោយអ្នកគាំទ្រ សម្រាប់អ្នកគាំទ្រ។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#models" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              See the models ↓ <span lang="km" class="font-khmer font-normal opacity-80">មើលម៉ូដែល</span>
            </a>
            <a href="#history" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              History → <span lang="km" class="font-khmer font-normal opacity-60">ប្រវត្តិ</span>
            </a>
          </div>
        </div>

        <!-- Illustration: a car racing on a road at night -->
        <div class="relative h-72 overflow-hidden rounded-3xl bg-ink shadow-2xl sm:h-96" aria-hidden="true">
          <div class="absolute top-[22%] left-[10%] h-1 w-24 rounded-full bg-paper/30"></div>
          <div class="absolute top-[34%] left-[4%] h-1 w-40 rounded-full bg-paper/20"></div>
          <div class="absolute top-[46%] left-[14%] h-1 w-28 rounded-full bg-brand/70"></div>
          <div class="absolute inset-x-0 bottom-0 h-24 bg-[#26282c]"></div>
          <div class="absolute inset-x-0 bottom-11 flex gap-6 overflow-hidden">
            <span class="h-1.5 w-16 shrink-0 rounded-full bg-sun"></span>
            <span class="h-1.5 w-16 shrink-0 rounded-full bg-sun"></span>
            <span class="h-1.5 w-16 shrink-0 rounded-full bg-sun"></span>
            <span class="h-1.5 w-16 shrink-0 rounded-full bg-sun"></span>
            <span class="h-1.5 w-16 shrink-0 rounded-full bg-sun"></span>
            <span class="h-1.5 w-16 shrink-0 rounded-full bg-sun"></span>
            <span class="h-1.5 w-16 shrink-0 rounded-full bg-sun"></span>
          </div>
          <span class="absolute right-[12%] bottom-14 -scale-x-100 text-8xl drop-shadow-2xl sm:text-9xl">🏎️</span>
          <p class="absolute top-6 right-6 font-display text-5xl font-extrabold text-paper/10 sm:text-7xl">911</p>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="border-y border-ink/10 bg-white">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-4xl font-extrabold text-brand">{s.value}</dd>
              <dd class="mt-1 text-sm text-muted">
                {s.label}
                <span class="km" lang="km">{s.labelKm}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- MODELS -->
    <section id="models" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">The models <span lang="km" class="font-khmer font-normal">· ម៉ូដែល</span></p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Meet the cars.</h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ស្គាល់រថយន្តទាំងនេះ។</p>
      <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          models.map((m) => (
            <li class="group rounded-2xl border border-ink/10 bg-white p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-xl">
              <div class="flex items-start justify-between">
                <span class="text-4xl">{m.icon}</span>
                <span class="rounded-full bg-ink/5 px-3 py-1 text-xs font-semibold text-muted">
                  {m.type} <span lang="km" class="font-khmer font-normal">· {m.typeKm}</span>
                </span>
              </div>
              <h3 class="mt-4 font-display text-3xl font-extrabold group-hover:text-brand">{m.name}</h3>
              <p class="mt-2 text-muted">
                {m.text}
                <span class="km" lang="km">{m.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- BIG STATEMENT -->
    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
        <p class="font-display text-3xl leading-tight font-bold text-balance sm:text-5xl">
          The 911 has kept <span class="text-brand">the same famous shape</span> for more than 60 years.
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          រថយន្ត 911 រក្សារាងដ៏ល្បីដដែល អស់រយៈពេលជាង ៦០ ឆ្នាំ។
        </p>
      </div>
    </section>

    <!-- HISTORY -->
    <section id="history" class="scroll-mt-20 bg-white">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="font-semibold text-brand">History <span lang="km" class="font-khmer font-normal">· ប្រវត្តិ</span></p>
          <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">More than 90 years.</h2>
          <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ជាង ៩០ ឆ្នាំ។</p>
        </div>
        <ol class="relative border-l-2 border-brand/30 pl-6">
          {
            history.map((h) => (
              <li class="relative pb-8 last:pb-0">
                <span class="absolute top-1.5 -left-[33px] size-4 rounded-full border-4 border-white bg-brand"></span>
                <p class="font-display text-2xl font-extrabold text-brand">{h.year}</p>
                <p class="mt-1 text-lg">
                  {h.text}
                  <span class="km text-muted" lang="km">{h.textKm}</span>
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- FACTS / FAQ -->
    <section id="facts" class="mx-auto max-w-3xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <h2 class="text-center font-display text-4xl font-extrabold tracking-tight">Fun facts</h2>
      <p class="km mt-2 text-center text-xl font-semibold" lang="km">ចំណេះដឹងគួរឱ្យចាប់អារម្មណ៍</p>
      <div class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold">
                <span>
                  {f.q}
                  <span class="km text-base" lang="km">{f.qKm}</span>
                </span>
                <span class="text-2xl text-brand transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-muted">
                {f.a}
                <span class="km" lang="km">{f.aKm}</span>
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <section class="px-4 pb-20 sm:px-6">
      <div class="mx-auto max-w-6xl rounded-3xl bg-brand px-6 py-16 text-center text-paper sm:py-20">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Which Porsche is your favorite?</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">តើ Porsche មួយណាដែលអ្នកចូលចិត្តជាងគេ?</p>
        <a href={`mailto:${site.contactEmail}`} class="mt-8 inline-block rounded-full bg-paper px-8 py-4 font-semibold text-ink transition hover:bg-sun">
          Tell me → <span lang="km" class="font-khmer font-normal">ប្រាប់ខ្ញុំ</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
